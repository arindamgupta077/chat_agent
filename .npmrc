# Electron compatibility - use flat node_modules
node-linker=hoisted

# Auto-install peer dependencies
auto-install-peers=true

# Preserved from original npm config
node-options=--max-old-space-size=5120
update-notifier=false
engine-strict=true

# Prevent binary downloads from GitHub / external CDNs during install
electron_skip_binary_download=true
sentrycli_skip_download=1
sharp_dist_base_url=https://none/
sharp_libvips_binary_host=https://none/

# Alternative mirrors (optional - uncomment if Electron binary is ever needed on an intranet/mirror):
# electron_mirror=https://npmmirror.com/mirrors/electron/
# sentrycli_cdnurl=https://npmmirror.com/mirrors/sentry-cli/
